PORT=5000

# Comma-separated list of frontend origins allowed to call this API
CLIENT_URL=http://localhost:5173

# Local development: path to the service account key downloaded from Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Deployed (Render etc.): paste the whole key file contents as one line of JSON.
# When this is set, it is used instead of the path above.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Paystack secret key (use sk_test_... during development and testing)
PAYSTACK_SECRET_KEY=

# Resend API Key & Email settings (optional in local dev; falls back to console log)
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=LearnX

# Secret for automated daily cron jobs (e.g. 3-day auto-confirm)
CRON_SECRET=learnx_dev_cron_secret

